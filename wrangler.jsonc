{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sidequest",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],

  // Cloudflare D1 Database Binding
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sidequest-db",
      "database_id": "ad0afffd-5698-461e-bef4-c4be7e51bc0f",
      "migrations_dir": "drizzle"
    }
  ],

  // Cloudflare R2 Object Storage Binding
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "sidequest-attachments"
    }
  ],

  // Cloudflare KV Namespace Binding
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "b60aaeb5488f4e80b85e3fd6ef5477e2"
    }
  ],

  // Cloudflare Cron Scheduled Triggers (every 30 mins)
  "triggers": {
    "crons": ["*/30 * * * *"]
  },

  // Observability & Logging
  "observability": {
    "enabled": true
  },

  // Non-secret environment variables
  "vars": {
    "ENVIRONMENT": "production",
    "BETTER_AUTH_URL": "https://sidequest.curtislamasters.workers.dev",
    "INBOUND_EMAIL_DOMAIN": "capture.sdvosb-proposals.mil"
  }
}
